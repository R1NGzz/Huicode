# 仅作为配置说明；不会自动加载。真实 .env 不应提交。
HUICODE_SERVER_ENV=development
# 用 127.0.0.1 而不是 localhost：Windows 会把 localhost 优先解析成 IPv6 的 ::1，
# 而 Docker Desktop 发布的端口只监听 IPv4，结果是连接超时。127.0.0.1 在各平台都对。
HUICODE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/huicode
HUICODE_REDIS_URL=redis://127.0.0.1:6379/0
# 使用 secrets.token_urlsafe(32) 生成，不使用示例固定密钥。
HUICODE_JWT_SECRET=
# 必须先创建专用目录，填写绝对路径；容器内填写容器路径。
HUICODE_PROJECT_ROOT=
HUICODE_CORS_ORIGINS=http://localhost:5173
HUICODE_LOG_LEVEL=INFO
HUICODE_MAX_RUN_SECONDS=1800
HUICODE_MAX_TOOL_SECONDS=120
HUICODE_MAX_SHELL_SECONDS=60
HUICODE_MAX_ITERATIONS=50
HUICODE_MAX_TOOL_CALLS=100
HUICODE_MAX_OUTPUT_BYTES=1048576
